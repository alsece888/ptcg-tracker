{
  "name": "ptcg-teable-bridge",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "vars": {
    "SITE_ORIGINS": "https://malo-ptcg.cn,https://www.malo-ptcg.cn",
    "TEABLE_TABLE_ID": "tblvmcKar5T76mmII8D"
  },
  "ratelimits": [
    { "name": "AUTH_RATE", "namespace_id": "1003", "simple": { "limit": 12, "period": 60 } },
    { "name": "READ_RATE", "namespace_id": "1001", "simple": { "limit": 40, "period": 60 } },
    { "name": "WRITE_RATE", "namespace_id": "1002", "simple": { "limit": 40, "period": 60 } }
  ]
}
